NAS_AUTO_PORT=14001

XHS_VOLUME_DIR=/volume2/docker/xhs-downloader/volumes
XHS_DOWNLOAD_DIR=/volume2/se-p/小红书
XHS_CONFIG_DIR=/volume2/docker/xhs-downloader/auto/config
XHS_QUEUE_DIR=/volume2/docker/xhs-downloader/auto/queue
XHS_STATE_DIR=/volume2/docker/xhs-downloader/auto/state

X_CONFIG_DIR=/volume2/docker/x-auto-download/config
X_STATE_DIR=/volume2/docker/x-auto-download/state
X_METADATA_DIR=/volume2/docker/x-auto-download/downloads-metadata
X_IMAGE_DIR=/volume2/se-p/x-p
X_VIDEO_DIR=/volume1/se-v/x-v

PIXIV_CONFIG_DIR=/volume2/docker/pixiv-auto-download/config
PIXIV_STATE_DIR=/volume2/docker/pixiv-auto-download/state
PIXIV_DOWNLOAD_DIR=/volume2/se-p/pixiv

# Defaults point at the single-container GHCR image built by GitHub Actions.
NAS_AUTO_IMAGE=ghcr.io/ccawmiku/nas-auto-download-integrated:v1.1.2

# Optional. Leave empty unless you need to override the browser user agent.
XHS_USER_AGENT=
